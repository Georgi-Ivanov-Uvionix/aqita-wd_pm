{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Keil-Flashed App",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/AQITA-PM.axf",
      "device": "STM32L471VG",
      "interface": "swd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32l4x.cfg"
      ],
      "svdFile": "C:/Program Files (x86)/Keil_v5/ARM/PACK/Keil/STM32L4xx_DFP/2.5.0/CMSIS/SVD/STM32L4x1.svd",
      "runToEntryPoint": "main",
      "loadMode": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    },
    {
      "name": "J-Link (Ultra) GXO 962",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      //"preLaunchTask": "Keil: Build",
      "serverpath": "C:/Program Files/SEGGER/JLink_V962/JLinkGDBServerCL.exe",
      "executable": "${workspaceFolder}/MDK-ARM/build/AQITA-PM.axf",
      "device": "STM32L471VG",
      "serialNumber": "507000366",
      "interface": "swd",
      "svdFile": "C:/Program Files (x86)/Keil_v5/ARM/PACK/Keil/STM32L4xx_DFP/2.5.0/CMSIS/SVD/STM32L4x1.svd",
      "runToEntryPoint": "main",
      "loadMode": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 10
      },
      "serverArgs": [
        "-if",
        "SWD",
        "-speed",
        "15000"
      ],
      "swoConfig": {
        "enabled": false,
        "cpuFrequency": 80000000,
        "swoFrequency": 12500000,
        "source": "probe",
        "decoders": [
          {
            "type": "console",
            "label": "ITM",
            "port": 0
          }
        ]
      }
    },    
